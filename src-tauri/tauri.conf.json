{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MyHomeAssistant",
  "version": "0.2.0",
  "identifier": "io.github.jcf2108.myhomeassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyHomeAssistant",
        "width": 316,
        "height": 52,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3RjVDQ0NGNDNGNzZBMkUKUldRdWF2ZER6OHoxUjMyWTBvWVVaWWl3WlpVWjNZdk1kU3V2Ym5MMGVKOWtadnVjbXU1WFJrTkIK",
      "endpoints": [
        "https://github.com/jcf2108/MyHomeAssistant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
